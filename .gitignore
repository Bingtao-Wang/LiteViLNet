# Python/cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.env
venv/
env/
ENV/

# Local datasets and generated artifacts
data/
runs/benchmark/*
runs/eval/*
runs/onnx/*
runs/tensorrt/*
runs/jetson_package/*
runs/summary/*
runs/train/*
third_party/**/outputs/

# Large model files
weights/**/*.pth
weights/**/*.pt
weights/**/*.ckpt
*.onnx
*.engine

# Keep directory skeletons and summaries
!.gitkeep
!runs/benchmark/.gitkeep
!runs/eval/.gitkeep
!runs/onnx/.gitkeep
!runs/tensorrt/.gitkeep
!runs/jetson_package/.gitkeep
!runs/summary/.gitkeep
!runs/summary/*.csv
!runs/train/.gitkeep
!third_party/**/README.md
!third_party/**/SOURCE.md

# IDE/system
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
